<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Fantastic Island</string>
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleURLName</key>
				<string>io.github.fantasticisland.x-oauth</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>fantastic-island</string>
				</array>
			</dict>
		</array>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSAppleEventsUsageDescription</key>
	<string>Fantastic Island needs access to Music, Podcasts, and Spotify so Player can read playback and control transport.</string>
		<key>NSCalendarsUsageDescription</key>
		<string>Fantastic Island uses calendar access to show your next event in Horizon.</string>
		<key>NSCalendarsFullAccessUsageDescription</key>
		<string>Fantastic Island uses calendar access to show your next event in Horizon.</string>
		<key>NSRemindersUsageDescription</key>
		<string>Fantastic Island uses reminders access to show your next due reminder in Horizon.</string>
		<key>NSRemindersFullAccessUsageDescription</key>
		<string>Fantastic Island uses reminders access to show your next due reminder in Horizon.</string>
		<key>NSLocationUsageDescription</key>
		<string>Fantastic Island uses your location to show local weather in Horizon.</string>
		<key>NSAccessibilityUsageDescription</key>
		<string>Fantastic Island checks whether the frontmost app is fullscreen so it can hide the island when requested.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
